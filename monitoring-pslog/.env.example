# Config for the pscontrol PS-log monitoring stack. Copy to .env and edit.
# Scrape-job values are baked into prometheus.yml by ./render.sh; the PORT/PASSWORD
# values are read by docker-compose at ./on.sh time.

# --- Prometheus scrape job (used by render.sh) ---
# Behind the SSH sidecar (default; needs `--profile tunnel`, see on.sh):
PSLOG_EXPORTER_TARGET=pslog-tunnel:9822
# ...or straight at the host, if PS_EXPORTER_ADDR=0.0.0.0 there and the port is open:
# PSLOG_EXPORTER_TARGET=pccmsbril06.cern.ch:9822
# ...or at an exporter running on this same docker host (local test / replay):
# PSLOG_EXPORTER_TARGET=host.docker.internal:9822
#
# The monitor writes a row every 6-9 s (measured), so 10s loses nothing and keeps
# the TSDB small; drop to 5s if you want ramps drawn more finely.
PSLOG_SCRAPE_INTERVAL=10s
SETUP=lab_cosmic_crocs
LOCATION=pccmsbril06

# --- SSH forward to the pscontrol host (used by the pslog-tunnel sidecar) ---
TUNNEL_SSH_TARGET=mbrandt@pccmsbril06.cern.ch
TUNNEL_REMOTE_HOSTPORT=127.0.0.1:9822

# --- Docker stack (used by docker-compose / on.sh) ---
# Deliberately NOT 9090/3000: ../monitoring (the CPX stack) owns those, and both
# are meant to be able to run on this host at the same time.
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=changeme
