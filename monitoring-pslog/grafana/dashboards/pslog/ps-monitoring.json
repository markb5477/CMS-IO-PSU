{
  "uid": "pslog-ps-monitoring",
  "title": "PS Monitoring \u2014 lab_cosmic_crocs",
  "description": "Power supplies read from pscontrol's values log via ps_exporter. Panels and thresholds are built around the channels and ranges actually present in the 2026-07-06..08-02 logs (356k rows).",
  "tags": [
    "pscontrol",
    "power-supplies"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Module",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pslog-prometheus"
        },
        "query": "label_values(pslog_voltage_volts{kind=\"HV\"}, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is monitoring alive?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Monitoring",
      "description": "pslog_up: the exporter found and read a values log. If this is red the power supplies are not necessarily in trouble \u2014 but nothing is watching them, and pscontrol's trip email is not running either.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pslog_up",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "background_solid",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STOPPED",
                  "index": 0
                },
                "1": {
                  "text": "RUNNING",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#c4162a",
                "value": null
              },
              {
                "color": "#1a7f37",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last row written",
      "description": "Age of the newest row in the log. Measured cadence on the real logs is 6\u20139 s (356k intervals, max 9 s), so anything past ~30 s means the monitor is struggling and past 60 s it has stalled.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - pslog_last_sample_timestamp_seconds",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 30
              },
              {
                "color": "#c4162a",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Channels",
      "description": "Channels in the current log's header. The lab_cosmic_crocs config has been 11 (8 LV + 3 HV) throughout the archive \u2014 a change here means the config changed.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pslog_active_channels",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Total power drawn",
      "description": "\u03a3 V\u00b7I over every channel, each product taken within one row. Dominated by the LV supplies \u2014 the HV channels contribute microwatts.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pslog_total_power_watts",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Unreadable rows this run",
      "description": "parse errors + misaligned rows. Both were exactly 0 across all 356,113 archived rows, so any non-zero value here means the log format changed or writes are being truncated \u2014 not a normal condition.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 17,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pslog_parse_errors_total + pslog_misaligned_rows_total",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1a7f37",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "CROC modules \u2014 LV",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CROC LV voltage",
      "description": "Observed operating band across the archive is 1.609\u20131.631 V; excursions reach 1.256 V. The 1.52/1.72 V guides mark \u00b1100 mV, the CROCLowVoltage alert threshold. Plotted alone rather than with the 10\u201314.5 V auxiliaries so a 20 mV droop is actually visible.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pslog_voltage_volts{kind=\"LV\", channel=~\"CROC.*\", device=~\"$device\"}",
          "legendFormat": "{{channel}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 1.55,
            "axisSoftMax": 1.68
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CROC3D"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CROCR29"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CROCR19"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "CROC LV current",
      "description": "Real range 0.79\u20131.98 A per module. The step changes are modules being powered on and off, not noise.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
