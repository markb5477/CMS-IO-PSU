    {
      "type": "timeseries",
      "title": "HV leakage current",
      "description": "The sensor-health signal, and the one number here that predicts trouble. Historical envelope: median 0.3\u20131.3 \u00b5A per channel, worst single reading 2.38 \u00b5A. The amber guide is the 5 \u00b5A HVLeakageHigh alert. Exactly 0 means the output is off, not a perfect sensor.",
      "datasource": {
        "type": "prometheus",
        "uid": "pslog-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abs(pslog_current_amps{kind=\"HV\", device=~\"$device\"})",
          "legendFormat": "{{device}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "decimals": 9,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisSoftMax": 3e-06,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 5e-06
              }
            ]
          }
        },
        "overrides": [
