{
  "title": "tk-fe-daq - test beam",
  "uid": "tkfe-daq",
  "description": "DAQ metrics written per spill by ext_trigger_daq_double_readout_v2 (--metrics-file) and served by scripts/prometheus_exposer.py. Counters restart at zero on every new run: read the rate panels for activity, the totals for the current run only.",
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "tags": [
    "tkfe",
    "daq",
    "testbeam",
    "tracker"
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "DAQ PC",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tkfe-prometheus"
        },
        "definition": "label_values(up{job=\"tkfe_daq\"}, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"tkfe_daq\"}, instance)",
          "refId": "A"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape link",
      "description": "Can Prometheus reach the exposer at all? DOWN = network or exposer process. Run ./check.sh.",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tkfe-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"tkfe_daq\", instance=~\"$instance\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Metrics file",
      "description": "MISSING = the exposer is running but the .prom file it was pointed at does not exist. Wrong --metrics-file path, or no run started yet.",
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tkfe-prometheus"
      },
      "targets": [
        {
          "expr": "tkfe_exposer_file_present{instance=~\"$instance\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PRESENT",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "MISSING",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Since last spill",
      "description": "Age of the DAQ's own timestamp. Without this a crashed DAQ would keep serving its last values and look perfectly healthy everywhere else.",
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tkfe-prometheus"
      },
      "targets": [
        {
          "expr": "time() - tkfe_daq_last_update_timestamp_seconds{instance=~\"$instance\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "FIFO at readout",
      "description": "1 = a FIFO was at its ceiling when the last spill was read, i.e. firmware dropped words before we ever saw them. That spill is truncated.",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tkfe-prometheus"
