##############################################################################
#  tk-fe-daq TEST BEAM MONITORING - ALL CONFIGURATION LIVES IN THIS FILE.
#
#  1.  cp .env.example .env
#  2.  edit the three NETWORK blocks below (they are the only things that
#      change from one beam period / one DAQ PC to the next)
#  3.  ./check.sh      <- tells you, line by line, what is reachable
#  4.  ./render.sh && ./on.sh
#
#  Nothing outside this file needs editing. render.sh bakes the scrape values
#  into prometheus/prometheus.yml; docker-compose reads the ports/passwords at
#  ./on.sh time.
##############################################################################


##############################################################################
# NETWORK BLOCK 1 - WHERE IS THE EXPORTER?               *** EDIT THIS ***
##############################################################################
# The DAQ writes a .prom file every spill; scripts/prometheus_exposer.py in the
# tk-fe-daq repo serves that file at http://<daq-pc>:9110/metrics.
# Start it on the DAQ PC with daq-host/start-exposer.sh (copy that file over).
#
# Comma-separated list of host:port - one entry per DAQ PC / per exposer.
# Prometheus labels each one with instance="<host:port>", so several DAQ PCs
# show up as separate lines on the same dashboard.
#
# Pick ONE of the three forms below.
#
#   (a) DIRECT  - the monitor PC can open a TCP connection to the DAQ PC.
#                 This is the normal case on a test-beam LAN. Requires the
#                 exposer to be started with --bind 0.0.0.0 (the default).
DAQ_EXPORTER_TARGETS=daq-pc.local:9110
#
#   (b) SSH TUNNEL - the DAQ PC is firewalled / on another subnet, but you can
#                 ssh to it. Set USE_TUNNEL=yes in block 2 and use:
# DAQ_EXPORTER_TARGETS=daq-tunnel:9110
#
#   (c) SAME BOX - Prometheus and the exposer run on this very machine.
#                 (Containers cannot see the host as "localhost".)
# DAQ_EXPORTER_TARGETS=host.docker.internal:9110
#
#   Several DAQ PCs at once (direct form):
# DAQ_EXPORTER_TARGETS=daq-pc-1:9110,daq-pc-2:9110

# How often to scrape. The DAQ rewrites its .prom file once per spill, so
# anything faster than the spill period just re-reads the same numbers.
# 5s draws spill structure nicely; raise to 15s if the link is bad.
DAQ_SCRAPE_INTERVAL=5s
# Give up on a scrape after this long. Keep it well under the interval.
# On a flaky/high-latency link raise this FIRST - a timeout shows as target
# DOWN and looks (wrongly) like the exposer died.
DAQ_SCRAPE_TIMEOUT=4s

# Free-text labels attached to every sample. Use them to tell one beam period /
# one setup apart from another in Grafana. No spaces.
SETUP=inner_tracker_croc
LOCATION=testbeam
BEAMTEST=2026


##############################################################################
# NETWORK BLOCK 2 - SSH TUNNEL (only if the DAQ PC is firewalled)
##############################################################################
# yes -> ./on.sh also starts the "daq-tunnel" sidecar container, which holds an
#        autossh connection to the DAQ PC and republishes its 127.0.0.1:9110 as
#        daq-tunnel:9110 inside the compose network. Then set
#        DAQ_EXPORTER_TARGETS=daq-tunnel:9110 in block 1.
# no  -> Prometheus scrapes the targets in block 1 directly. No key needed.
USE_TUNNEL=no

# user@host of the DAQ PC (or of a gateway that can see it).
TUNNEL_SSH_TARGET=user@daq-pc.cern.ch
# What to reach ON THAT HOST once the ssh connection is up. 127.0.0.1:9110 is
# right when the exposer runs on the DAQ PC itself; point it at another
# host:port to hop through a gateway.
TUNNEL_REMOTE_HOSTPORT=127.0.0.1:9110
# Extra ssh options, e.g. a jump host or forcing IPv4 past a dead AAAA record:
#   TUNNEL_SSH_EXTRA_OPTS=-4 -J lxtunnel.cern.ch
TUNNEL_SSH_EXTRA_OPTS=
# The tunnel needs a PASSWORDLESS key at tunnel/id_ed25519 (mode 600) whose .pub
# is in ~/.ssh/authorized_keys on TUNNEL_SSH_TARGET:
#   ssh-keygen -t ed25519 -N '' -f tunnel/id_ed25519
#   ssh-copy-id -i tunnel/id_ed25519.pub user@daq-pc.cern.ch


##############################################################################
# NETWORK BLOCK 3 - PORTS ON THIS MACHINE                *** CHECK THIS ***
##############################################################################
# Deliberately NOT 9090/3000 or 9091/3001: ../monitoring (CPX PSU) and
# ../monitoring_beam_test own those, and all of them are meant to be able to run
# on this host at the same time. Change these if something else already listens.
PROMETHEUS_PORT=9092
GRAFANA_PORT=3002

# Bind address for the two web UIs. 0.0.0.0 = anyone on the LAN can open the
# dashboard (what you usually want in a control room). Use 127.0.0.1 to keep
# them local-only and reach them over an ssh -L tunnel instead.
WEB_BIND_ADDR=0.0.0.0

# Grafana login. Anonymous view-only access is handy for a control-room screen:
# set GRAFANA_ANON=yes and the dashboard opens with no login at all.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ANON=no


##############################################################################
# STORAGE
##############################################################################
# *** 1 week of history, as asked. *** Prometheus drops samples older than this.
# At 5s scrape / ~10 series this is a few tens of MB - keeping more is cheap,
# so raise it (e.g. 30d) if you want the whole beam period in one place.
PROM_RETENTION=7d
# Hard cap on the TSDB size; whichever limit is hit first wins. Insurance
# against filling the disk on a small VM. Set to 0 to disable.
PROM_RETENTION_SIZE=5GB


##############################################################################
# IMAGES - pin these if you ever need to redeploy without a registry
##############################################################################
# ./install.sh --pull downloads exactly these, so a later ./on.sh works with no
# network to Docker Hub at all. ":latest" is fine on a good link; pin to a
# digest/tag (e.g. v3.1.0 / 11.5.0) before travelling to the beam line.
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
